{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "spacing": 0,
  "height": 32,
  "width": 1440,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-right": 0,
  "margin-left": 0,
  "modules-left": ["group/left1", "group/left3", "group/left4"],

  "group/left1": {
    "orientation": "inherit",
    "modules": ["clock", "network"]
  },

  "group/left3": {
    "orientation": "inherit",
    "modules": ["idle_inhibitor"]
  },

  "group/left4": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },

  "modules-center": ["hyprland/workspaces"],

  "modules-right": ["group/right1", "group/right"],

  "group/right1": {
    "orientation": "inherit",
    "modules": ["tray"]
  },

  "group/right": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "memory", "cpu", "battery"]
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四", "5": "五",
      "6": "六", "7": "七", "8": "八", "9": "九", "10": "十"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "󰾫"
    }
  },

  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%"
  },

  "memory": {
    "interval": 2,
    "format": "mem {used:0.1f}G"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "on-click": "nm-connection-editor"
  }




,

  "pulseaudio": {
    "format": "vol {volume}%",
    "on-click": "pavucontrol",
    "format-muted": ""
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "mpris": {
    "format": " {artist} - {title}",
    "max-length": 50
  }
}
