{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 10,
        "width": 10,
        "padding": {
            "top": 0,
            "left": 2
        }
    },
    "modules": [
        "break",
        
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "│ ├󰍹 ",
            "format":"NVIDIA GeForce RTX 3080",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "green"
        },
        
        "break",
        
    ]
}
